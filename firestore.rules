rules_version = '2';

// BOOM Roma — Firestore Security Rules
// Source of truth for the deployed rules. Kept in sync with what's live in the
// Firebase console (project boom-property-dashboards). Deploy with:
//   firebase deploy --only firestore:rules
//
// PUBLIC CATALOG: `listings` + `settings` are readable by everyone (the public
// website reads them unauthenticated — apartments grid, /listing/:id, hubs,
// homepage video). Writes stay admin-only. Locking their READ is what took
// /apartments down with PERMISSION_DENIED — keep it open.
//
// IL PROPRIETARIO LEGGE SOLO VIA /api/owner/* (22/09/2026). Fino a questa
// data un landlord leggeva dal browser properties/contracts/payments/
// maintenance dei propri immobili, i documenti condivisi e l'Inbox: il
// contratto portava tenantSignToken (firmare COME l'inquilino), gli URL
// tokenizzati degli identityDocs, CF e IP del conduttore; i pagamenti i
// margini. Ora quei rami non esistono più: l'Archivio del Proprietario
// (/proprietario) legge dal server una proiezione pulita (assertClean) e
// il browser del proprietario non tocca più Firestore per quei dati.
// Restano: il proprio users, invoices (recipientId), documentShares e
// taxPacks. tests/owner/security.mjs lo asserisce sul testo; il job CI
// firestore-rules (tests/rules/runner.mjs) sull'emulatore.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function uid()        { return request.auth.uid; }
    function userDoc()    { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function role()       { return isSignedIn() ? userDoc().role : ''; }
    function isAdmin()    { return isSignedIn() && role() == 'admin'; }
    function isLandlord() { return isSignedIn() && role() == 'landlord'; }
    function isTenant()   { return isSignedIn() && role() == 'tenant'; }
    function isAnon()     { return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    function propertyData(pid) {
      return get(/databases/$(database)/documents/properties/$(pid)).data;
    }
    function contractData(cid) {
      return get(/databases/$(database)/documents/contracts/$(cid)).data;
    }
    // ownsProperty() è stato RIMOSSO (22/09/2026): era la porta con cui un
    // landlord leggeva contratti e pagamenti dal browser. Non reintrodurlo:
    // il proprietario legge via /api/owner/* (vedi l'intestazione).
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ─── PUBLIC CATALOG — read open to all, writes admin-only ─────────
    match /listings/{x}  { allow read: if true; allow write: if isAdmin(); }
    // publicGeo: griglie derivate da SOLI dati pubblici (i tempi GTFS del
    // Pendolare) — la vetrina le legge anonima come legge il catalogo.
    match /publicGeo/{x} { allow read: if true; allow write: if isAdmin(); }
    // settings è pubblico (il sito legge config di pagina), MA il doc
    // `company` porta IBAN e dati bancari: la stessa ragione per cui
    // /payout esiste separato. Chi è autenticato (portal, /casa) lo
    // legge; l'API anonima no. (Audit 2026-08, S2.)
    // 'company' (IBAN) e 'registrazione' (email personale del referente
    // ASPI) non si servono al pubblico anonimo — stessa lezione.
    // 'ai' porta l'URL del tunnel verso il Mac dell'operatore: non è per il pubblico.
    match /settings/{x}  { allow read: if !(x in ['company', 'registrazione', 'ai']) || request.auth != null; allow write: if isAdmin(); }
    // Coordinate per il bonifico del canone. NON in /settings, che è
    // leggibile da chiunque via API: un IBAN esposto così invita scraping.
    // L'inquilino che deve pagare è comunque autenticato.
    match /payout/{x}    { allow read: if request.auth != null; allow write: if isAdmin(); }

    // ─── users ────────────────────────────────────────────────────────
    // Chi possiede la scheda la aggiorna (nome, telefono, lastLogin,
    // onboarding, push, i dati d'identità), MAI i campi che decidono CHI è e
    // COSA vede. 23/09/2026 (revisione avversariale dell'Archivio del
    // Proprietario): fino a qui era chiuso solo `role`, e un landlord poteva
    // scriversi `ownerAliases:[<uid di un altro>]` sulla propria scheda —
    // /api/owner/* legge lì gli alias e gli consegnava rendiconti e documenti
    // dell'altro. Con `email` e i timbri d'invito scrivibili, poi, l'invito
    // prendeva per "suo" un account che si era dato l'email di un altro
    // proprietario. `accountConfirmedAt/By` sono la firma dell'admin che ha
    // garantito l'account all'invito: scritti da sé, direbbero che qualcuno
    // ha garantito ciò che nessuno ha visto. Questi campi li scrivono solo l'admin e il server
    // (api/owner/invite.js, api/owner/archivio.js), con credenziali admin.
    // Nessuna pagina li aggiorna sulla propria scheda (verificato: portal,
    // login, tenant, scheda/sign passano dalle API). tests/rules/runner.mjs
    // e tests/owner/security.mjs lo tengono.
    match /users/{userId} {
      allow read:   if isAdmin() || uid() == userId;
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (uid() == userId
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'email', 'authUid', 'ownerAliases',
                                       'ownerInvitedAt', 'ownerInvitedBy',
                                       'ownerInviteSentAt', 'ownerPortalFirstAt',
                                       'accountConfirmedAt', 'accountConfirmedBy']));
      allow delete: if isAdmin();
    }

    // ─── properties ───────────────────────────────────────────────────
    match /properties/{propId} {
      allow read: if isAdmin()
                  || (isTenant()
                      && resource.data.currentContractId != null
                      && contractData(resource.data.currentContractId).tenantId == uid());
      allow create, update, delete: if isAdmin();
    }

    // ─── contracts ────────────────────────────────────────────────────
    match /contracts/{cId} {
      allow read: if isAdmin()
                  || (isTenant() && resource.data.tenantId == uid());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isTenant() && resource.data.tenantId == uid()
                        && onlyChanges(['tenantSignature','tenantSignedAt','tenantSignIP',
                                        'tenantSignUA','tenantSignToken','tenantSignedStatus']));
    }

    // ─── payments ─────────────────────────────────────────────────────
    match /payments/{pId} {
      allow read: if isAdmin()
                  || (isTenant() && resource.data.tenantId == uid());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isTenant() && resource.data.tenantId == uid()
                        && onlyChanges(['tenantReported','tenantReportedAt','tenantReportDate',
                                        'tenantNotes','proofUrl','proofName']));
    }

    // ─── maintenance ──────────────────────────────────────────────────
    match /maintenance/{mId} {
      allow read:   if isAdmin()
                    || (isTenant() && resource.data.userId == uid());
      // L'admin può aprire una segnalazione PER un inquilino: succede ogni
      // volta che qualcuno telefona invece di usare l'app, e serve
      // all'inquilino di prova. Senza `isAdmin()` la regola ammetteva solo
      // "creo per me stesso" e ogni scrittura server-side per conto di terzi
      // tornava PERMISSION_DENIED.
      allow create: if isAdmin()
                    || (isSignedIn() && request.resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ─── documents ────────────────────────────────────────────────────
    match /documents/{dId} {
      // Il proprio documento NON vale per il landlord: la copia di
      // attivazione (userId = landlord, fileUrl = generatedPDF, un PDF con
      // l'identità del conduttore) e i documenti dell'Innesto con
      // party:'landlord' (il party è la stima del modello) gli
      // consegnerebbero URL tokenizzati. Il proprietario li vede solo dalla
      // proiezione del server, che applica la tabella di visibilità.
      allow read: if isAdmin()
                  || (resource.data.userId == uid() && !isLandlord())
                  || (resource.data.shared == true && resource.data.propertyId != null
                      && isTenant()
                      && propertyData(resource.data.propertyId).currentContractId != null
                      && contractData(propertyData(resource.data.propertyId).currentContractId).tenantId == uid());
      // `isAdmin()` come in maintenance: il server archivia i documenti legali
      // PER conto di terzi (contratto firmato → userId dell'inquilino, bozza
      // RLI, deal-archive). Senza questo ramo ogni scrittura post-firma
      // tornava PERMISSION_DENIED e l'archiviazione legale non avveniva mai
      // (portal-app.js:1818/17263/17276/19468 — audit 2026-08-18 P0.3).
      // Scrittura: nemmeno il landlord scrive dal browser (22/09/2026). Prima
      // poteva creare un documento `shared` su un immobile QUALSIASI con un
      // fileUrl qualsiasi, e il ramo inquilino qui sopra lo mostrava al
      // conduttore di quella casa: un link arbitrario firmato BOOM.
      allow create: if isAdmin()
                    || (isSignedIn() && !isLandlord() && request.resource.data.userId == uid());
      allow update, delete: if isAdmin() || (resource.data.userId == uid() && !isLandlord());
    }

    // ─── notifications ────────────────────────────────────────────────
    match /notifications/{nId} {
      allow read, update, delete: if isAdmin() || resource.data.userId == uid();
      // Le sessioni anonime (magic-link/intake) non hanno motivo di creare
      // notifiche: senza questo vincolo potevano fabbricarne verso qualsiasi
      // utente. I ruoli veri (admin/landlord/tenant) restano liberi perché il
      // portale crea notifiche cross-utente legittimamente.
      allow create: if isSignedIn() && !isAnon();
    }

    // ─── magicLinks ───────────────────────────────────────────────────
    match /magicLinks/{tId} {
      // get: an anon session may resolve ONE link it holds the ID of.
      // list: admin only — read:(get+list) let any anon session ENUMERATE all
      // pending welcome tokens (doc ID = the token) and hijack/burn them.
      allow get:    if isAdmin() || isAnon();
      allow list:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAnon()
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && onlyChanges(['used','usedAt']);
      allow delete: if isAdmin();
    }

    // ─── conversations + messages (Inbox unificato) ──────────────────
    match /conversations/{convId} {
      allow read:   if isAdmin()
                    || (resource.data.contactUid == uid());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /messages/{msgId} {
      allow read:   if isAdmin()
                    || (resource.data.contactUid == uid());
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.by == uid()
                        && request.resource.data.direction in ['out','in','note']);
      allow update, delete: if isAdmin();
    }

    // ─── invoices ─────────────────────────────────────────────────────
    match /invoices/{x} {
      allow read:  if isAdmin() || resource.data.recipientId == uid();
      allow write: if isAdmin();
    }

    // ─── viewingRequests ──────────────────────────────────────────────
    // Le prenotazioni pubbliche entrano SOLO da /api/viewings/slots, che
    // scrive con credenziali admin (verificato: nessun client scrive qui
    // direttamente). `create: if true` era una porta aperta — un attaccante
    // scriveva campi arbitrari aggirando slots.js, e quel testo finiva in un
    // innerHTML del portale (XSS nella sessione admin — audit 2026-08-18 P0.4).
    match /viewingRequests/{x} {
      allow read, create, update, delete: if isAdmin();
    }
    // `viewings` è il nome LEGACY della stessa cosa: nessuno scrive qui
    // (slots.js scrive viewingRequests), ma tre lettori la interrogavano e
    // senza regola cadeva nel default-deny — 403 anche con credenziali
    // admin: il backup notturno la segnava «ILLEGGIBILE» e la Promise.all
    // del Richiamo e della Miniera saltava intera (13/09/2026). Con la
    // regola una lettura risponde un onesto «0 documenti».
    match /viewings/{x} { allow read, write: if isAdmin(); }

    // ─── config ───────────────────────────────────────────────────────
    match /config/{x} { allow read, write: if isAdmin(); }

    // ─── operatorTasks (Il Regista: foglio di chiamata + promemoria) ──
    // Solo admin; i cron scrivono con credenziali admin. Senza questa riga
    // cadrebbe nel default-deny (la lezione di propertyLocks).
    match /operatorTasks/{x} { allow read, write: if isAdmin(); }

    // ─── activityLog ──────────────────────────────────────────────────
    match /activityLog/{x} {
      allow read:   if isAdmin();
      // Append-only, ma non per gli anonimi: evita l'avvelenamento dell'audit
      // log da sessioni magic-link/intake. I server (admin creds) bypassano.
      allow create: if isSignedIn() && !isAnon();
      allow update, delete: if false;
    }

    // ─── registrations (form onboarding pubblico) ─────────────────────
    // Il visitatore compila senza login (onboarding.html scrive qui diretto,
    // quindi NON si può chiudere come viewingRequests). Ma `create: if true`
    // lasciava iniettare campi e payload arbitrari: si vincola la FORMA —
    // solo le chiavi note del form e tetti di lunghezza — così un campo
    // estraneo o un payload gigante viene rifiutato alla porta (audit
    // 2026-08-18 P0.4). Un nuovo campo del form va aggiunto qui: il test
    // delle rules lo prende prima della produzione.
    match /registrations/{x} {
      allow create: if request.resource.data.keys().hasOnly([
                         'name','firstName','lastName','email','phone','budget',
                         'duration','durationMonths','checkIn','guests','zones','zone',
                         'requirements','petFriendly','furnished','parking','terrace',
                         'workStudyLocation','advancePayment','referralSource','notes',
                         'service','stage','source','status','createdAt',
                         'submittedFrom','formDuration'
                       ])
                       && request.resource.data.get('notes','').size() < 4000
                       && request.resource.data.get('name','').size() < 300
                       && request.resource.data.get('email','').size() < 320;
      allow read, update, delete: if isAdmin();
    }

    // ─── deals (console deals.html, admin) ────────────────────────────
    match /deals/{x} { allow read, write: if isAdmin(); }

    // ─── clientErrors (telemetria browser → console /salute) ──────────
    // Scritti SOLO dal server (/api/log, admin creds); l'admin li legge.
    match /clientErrors/{x} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── pass studio (passRegistrations / passMeta) ───────────────────
    // Console admin (pass-studio.html) + endpoint server (bypassano le rules).
    match /passRegistrations/{x} { allow read, write: if isAdmin(); }
    match /passMeta/{x}          { allow read, write: if isAdmin(); }

    // ─── documentShares ───────────────────────────────────────────────
    match /documentShares/{shareId} {
      allow read:   if isAdmin() || (isLandlord() && resource.data.ownerId == uid());
      allow create: if isAdmin() || (isLandlord() && request.resource.data.ownerId == uid());
      allow update, delete: if isAdmin() || (isLandlord() && resource.data.ownerId == uid());
    }

    // ─── taxPacks ─────────────────────────────────────────────────────
    match /taxPacks/{packId} {
      allow read:   if isAdmin() || (isLandlord() && resource.data.ownerId == uid());
      allow create: if isAdmin() || (isLandlord() && request.resource.data.ownerId == uid());
      allow update, delete: if isAdmin() || (isLandlord() && resource.data.ownerId == uid());
    }

    // ─── Admin-only operational collections ───────────────────────────
    match /leads/{x}                      { allow read, write: if isAdmin(); }
    match /pfsClients/{x}                  { allow read, write: if isAdmin(); }
    match /pfsProperties/{x}               { allow read, write: if isAdmin(); }
    match /pfsActivities/{x}               { allow read, write: if isAdmin(); }
    match /landlords/{x}                   { allow read, write: if isAdmin(); }
    match /clients/{x}                     { allow read, write: if isAdmin(); }
    match /action_queue/{x}                { allow read, write: if isAdmin(); }
    match /signRequests/{x}                { allow read, write: if isAdmin(); }
    match /rules/{x}                       { allow read, write: if isAdmin(); }
    match /ruleExecutions/{x}              { allow read, write: if isAdmin(); }
    match /deadlines/{x}                   { allow read, write: if isAdmin(); }
    match /tasks/{x}                       { allow read, write: if isAdmin(); }
    match /radarSearches/{x}               { allow read, write: if isAdmin(); }
    match /pfsRadarHealth/{x}              { allow read, write: if isAdmin(); }
    match /preProperties/{x}               { allow read, write: if isAdmin(); }
    match /ziShortlists/{x}                { allow read, write: if isAdmin(); }
    match /contractRegistrations/{x}       { allow read, write: if isAdmin(); }
    match /contractRegistrationStatus/{x}  { allow read, write: if isAdmin(); }
    match /messageLog/{x}                  { allow read: if isAdmin(); allow write: if false; }
    match /telegramState/{x}               { allow read, write: if isAdmin(); }
    match /heartbeat/{x}                   { allow read, write: if isAdmin(); }
    match /agentNotifications/{x}          { allow read, write: if isAdmin(); }
    match /preAgreements/{x}               { allow read, write: if isAdmin(); }
    match /savedSearches/{x}               { allow read, write: if isAdmin(); }
    match /teamHealth/{x}                  { allow read, write: if isAdmin(); }
    match /teamReports/{x}                 { allow read, write: if isAdmin(); }
    // La Centrale AI: contatori per scopo (aiUsage/<giorno>) e coppie
    // cloud/locale dell'ombra (aiShadow/<scopo>) — solo numeri, mai contenuto,
    // e comunque admin-only (la lezione propertyLocks: senza la riga si cade
    // nel default-deny e i contatori non si scrivono affatto).
    match /aiUsage/{x}                     { allow read, write: if isAdmin(); }
    match /aiShadow/{x}                    { allow read, write: if isAdmin(); }
    match /bankAccounts/{x}                { allow read, write: if isAdmin(); }
    match /bankTransactions/{x}            { allow read, write: if isAdmin(); }
    match /bankRequisitions/{x}            { allow read, write: if isAdmin(); }
    match /bankImports/{x}                 { allow read, write: if isAdmin(); }
    match /docImports/{x}                  { allow read, write: if isAdmin(); }
    match /complianceState/{x}             { allow read, write: if isAdmin(); }
    // Lucchetti sull'immobile (api/preagreement/_lock.js): impediscono che due
    // candidati chiudano lo stesso appartamento. Scritti SOLO server-side con
    // le credenziali admin — che passano comunque da queste regole, quindi
    // senza questa riga cadrebbero nel default-deny e il lucchetto non
    // funzionerebbe affatto.
    match /propertyLocks/{x}               { allow read, write: if isAdmin(); }
    // 🐞 Segnala (STUDIO_ARSENALE_II): le segnalazioni bug dell'operatore,
    // scritte dal portale/console col contesto tecnico allegato.
    match /bugReports/{x}                  { allow read, write: if isAdmin(); }
    // Rendiconto mensile proprietari: memoria idempotenza (ownerId_YYYY-MM),
    // scritta dal cron con credenziali admin. Stessa lezione di propertyLocks.
    match /rendiconti/{x}                  { allow read, write: if isAdmin(); }
    // IL PERITO — libro mastro del mercato (fatti degli annunci, mai contatti)
    // e statistiche per zona. Scritti dai cron/porte con credenziali admin,
    // letti dal portal (admin). Senza queste righe: default-deny — la lezione
    // di propertyLocks, di nuovo.
    match /marketListings/{x}              { allow read, write: if isAdmin(); }
    match /marketStats/{x}                 { allow read, write: if isAdmin(); }
    // Stato pubblicazioni portali (Il Pubblicista, api/publisher/queue.js):
    // un doc per (portale, listing) con l'hash del contenuto pubblicato.
    // Scritti solo server-side con credenziali admin — stessa lezione.
    match /portalPubs/{x}                  { allow read, write: if isAdmin(); }
    // LA MINIERA — righe per-thread dello storico WhatsApp (feature +
    // campioni corti, mai l'archivio integrale — api/homie/miniera.js).
    // Scritte solo server-side con credenziali admin — stessa lezione.
    match /minieraThreads/{x}              { allow read, write: if isAdmin(); }
    // IL RICHIAMO — campagne di ricontatto lead (api/leads/_richiamo.js):
    // audience, esclusi col motivo, stato pending→sent. Solo server-side
    // con credenziali admin — stessa lezione.
    match /richiamoCampaigns/{x}           { allow read, write: if isAdmin(); }
    match /scrivanoProposals/{x}           { allow read, write: if isAdmin(); }   // la coda dello Scrivano: proposte, mai contratti
    // IL RADAR 2.0 (La Centrale — /radar): le vedette (ricerche libere con
    // coda per il digest email, api/radar/digest.js + _tap.js) e lo stato
    // del radar (indice gemelli cross-portale, feed occasioni, card
    // mandati). Scritti da tap e cron con credenziali admin, letti e
    // gestiti dalla console (admin). Stessa lezione di propertyLocks.
    match /radarWatchers/{x}               { allow read, write: if isAdmin(); }
    match /radarState/{x}                  { allow read, write: if isAdmin(); }
    // IL CONTATTO — la coda dei messaggi al proprietario (api/outreach/*):
    // creati dalla plancia (admin) col tap che È l'approvazione, eseguiti
    // dal Mac via server con credenziali admin. Stessa lezione.
    match /outreachQueue/{x}               { allow read, write: if isAdmin(); }
    // IL CENTRALINO — un doc per chiamata deviata in segreteria
    // (api/phone/inbound.js + recording.js: audio, trascrizione, azione
    // consigliata, leadId). Scritti server-side con credenziali admin, letti
    // e gestiti da /chiamate (admin). Stessa lezione di propertyLocks.
    match /phoneCalls/{x}                  { allow read, write: if isAdmin(); }

    // ─── Default deny ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
