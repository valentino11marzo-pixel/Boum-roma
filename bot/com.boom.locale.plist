<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.boom.locale — IL PONTE fra la Centrale AI e Ollama, sempre acceso.
  KeepAlive: se cade, launchd lo rialza; RunAtLoad: parte al login.
  I percorsi (Python, cartella) li scrive install_locale.sh con quelli VERI
  del Mac: questo file nel repo è il riferimento.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boom.locale</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/boomserver/boom-locale/boom_locale.py</string>
        <string>--serve</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/boomserver/boom-locale</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/boomserver/boom-locale/locale.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/boomserver/boom-locale/locale.err.log</string>
</dict>
</plist>
